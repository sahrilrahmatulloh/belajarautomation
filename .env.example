# Lingkungan aplikasi (PRD Bagian 13.3). Salin ke .env.local lalu sesuaikan.
# Nilai yang tersedia:
#   dev        - branch develop; fitur bantu pengembangan aktif, label "DEV"
#   uat        - branch uat; untuk pengujian penerimaan, label "UAT"
#   production - branch main; tanpa label dan tanpa fitur bantu pengembangan
# Jika kosong, aplikasi memakai "dev".
NEXT_PUBLIC_APP_ENV=dev

# Alamat situs untuk Open Graph dan sitemap, tanpa garis miring di akhir.
# Isi di Production saat domain sudah pasti. Jika kosong, memakai alamat dari Vercel.
NEXT_PUBLIC_SITE_URL=
