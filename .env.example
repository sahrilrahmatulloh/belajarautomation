# Lingkungan aplikasi (PRD Bagian 13.3). Salin ke .env.local lalu sesuaikan.
# Nilai yang tersedia:
#   dev        - branch develop; fitur bantu pengembangan aktif, label "DEV"
#   uat        - branch uat; untuk pengujian penerimaan, label "UAT"
#   production - branch main; tanpa label dan tanpa fitur bantu pengembangan
# Jika kosong, aplikasi memakai "dev".
NEXT_PUBLIC_APP_ENV=dev

# Alamat situs untuk Open Graph dan sitemap, tanpa garis miring di akhir.
# Isi di Production saat domain sudah pasti. Jika kosong, memakai alamat dari Vercel.
NEXT_PUBLIC_SITE_URL=

# Supabase (docs/DATABASE.md Bagian 2). Ambil dari dashboard project:
# Project Settings > Data API (URL) dan API Keys (Publishable key, sb_publishable_...).
# Keduanya aman dipakai di browser karena akses dibatasi RLS.
# URL ditulis tanpa /rest/v1/ di belakang.
# Jika kosong, aplikasi tetap berjalan dengan data dummy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JANGAN isi kunci rahasia di file ini atau di .env.local yang dibagikan.
# Secret key / service_role, MIDTRANS_SERVER_KEY, dan RESEND_API_KEY
# hanya diisi di Vercel, dan tidak pernah memakai awalan NEXT_PUBLIC_.
