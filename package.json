{
  "name": "web_belajarautomation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:covers && npm run check:roadmaps && npm run check:challenges && npm run check:progress && npm run check:activity && npm run check:content && npm run check:blog && npm run check:lessons && npm run check:cosmetics",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:non-dev": "playwright test --config playwright.non-dev.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:covers": "node scripts/check-covers.mjs",
    "check:cosmetics": "node scripts/check-cosmetics.mjs",
    "check:roadmaps": "node scripts/check-roadmaps.mjs",
    "check:challenges": "node scripts/check-challenges.mjs",
    "check:progress": "node scripts/check-learning-progress.mjs",
    "check:activity": "node scripts/check-activity.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content:release": "node scripts/check-content.mjs --strict",
    "check:blog": "node scripts/check-blog.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:youtube": "node scripts/check-youtube-links.mjs",
    "optimize:covers": "node scripts/optimize-covers.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:ranks": "node scripts/optimize-images.mjs ranks",
    "db:link": "supabase link",
    "db:push": "supabase db push --remote",
    "db:diff": "supabase db diff --remote",
    "db:types": "supabase gen types typescript --remote --schema public > types/supabase.ts",
    "db:push:dry": "supabase db push --remote --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/mdx": "^3.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.12.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
